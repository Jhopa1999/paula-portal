# ==========================================================================
# Nginx - reverse proxy para el backend NestJS del portal Paula.
# Coloca este archivo (ajustado) en /etc/nginx/sites-available/paula-api
# y crea el symlink en /etc/nginx/sites-enabled/.
#
# Requisitos:
#   - Reemplaza api.tudominio.com por tu dominio real.
#   - El backend Nest corre en localhost:3000 (API_PORT).
#   - Genera el certificado TLS con Certbot:
#       sudo certbot --nginx -d api.tudominio.com
#     (Certbot completara/anadira el bloque 443 y la redireccion 80->443.)
# ==========================================================================

# Necesario para el upgrade de WebSocket (socket.io / namespace /realtime).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name api.tudominio.com;

    # Certbot suele gestionar la redireccion a HTTPS automaticamente.
    # Si lo haces manual, descomenta:
    # return 301 https://$host$request_uri;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        # Headers estandar de proxy.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # --- Soporte WebSocket (imprescindible para /realtime) ---
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Timeouts holgados para conexiones WebSocket de larga vida.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
