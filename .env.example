# ==========================================================================
# Paula Portal - Variables de entorno de ejemplo
# Copia este archivo como `.env` y ajusta los valores. NUNCA subas `.env`.
# ==========================================================================

# --- NestJS API ---
API_PORT=3000
NODE_ENV=development

# CORS: origen del frontend Angular en desarrollo
CORS_ORIGIN=http://localhost:4200

# --- Bot Core (Brayan) ---
# En Fase 0 usamos un adapter mock; estas variables aplican cuando exista la API real.
BOT_CORE_BASE_URL=http://localhost:9000/internal/v1
BOT_CORE_API_KEY=changeme

# --- Autenticacion (Cognito / OIDC) - se completa en 01-auth ---
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ISSUER=

# --- Selector de adapter ---
# mock = usa datos simulados en memoria; http = llama a la API real del Bot Core
BOT_CORE_ADAPTER=mock
